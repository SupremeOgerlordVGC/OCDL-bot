# systemd unit for the draft bot.
#
#   sudo cp draftbot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now draftbot
#
# This assumes the README's setup: a non-root user called "draftbot" with the
# bot in its home directory. Change User= and the two paths if yours differs.

[Unit]
Description=Pokemon Draft League Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=draftbot
WorkingDirectory=/home/draftbot/OCDL-Bot
ExecStart=/home/draftbot/OCDL-Bot/.venv/bin/python bot.py

# Restart on any exit, including a crash or a reboot. This plus the SQLite
# database is what stops a reboot losing a draft.
Restart=always
RestartSec=10

# Logs go to the journal: view them with `journalctl -u draftbot -f`
StandardOutput=journal
StandardError=journal

# Modest hardening: the bot only needs its own directory and outbound network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/draftbot/OCDL-Bot

[Install]
WantedBy=multi-user.target
