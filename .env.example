# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file to git.

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=paste-your-token-here

# Optional: restrict slash-command syncing to one server while testing.
# Commands appear instantly in that server instead of taking up to an hour.
# Leave blank to register commands globally.
DEV_GUILD_ID=

# Optional: path to the Google service-account JSON key.
# Leave blank to run without Google Sheets.
GOOGLE_CREDENTIALS_FILE=credentials.json

# Optional: set to true ONLY after enabling "Server Members Intent" in the
# Developer Portal. It lets /setup take a role instead of a list of
# @mentions. Asking for it before enabling it there makes Discord refuse
# the connection repeatedly, so leave it off until you have.
REQUEST_MEMBERS_INTENT=false
